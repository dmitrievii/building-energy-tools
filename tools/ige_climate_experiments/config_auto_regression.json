{
  "schema": "IGE_AUTO_REGRESSION_CONFIG_v1",
  "database": "../Database",
  "results": "./regression_results",
  "countries": ["AT", "DE", "CH"],
  "variables": ["T", "RH", "p", "log_e_water"],
  "years": {"D": [2019, 2020, 2021], "V": [2023], "C": [2025]},
  "sample_days_per_month": 2,
  "sample_start_day": 15,
  "sites_per_country": 24,
  "split_seed": 20261107,
  "split_fractions": {"D": 0.6, "V": 0.2, "C": 0.2},
  "inner_folds": 3,
  "qc_mode": "primary",
  "rejected_native_qc": {"AT": [], "DE": [], "CH": []},
