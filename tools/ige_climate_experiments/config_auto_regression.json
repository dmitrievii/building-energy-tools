  "optimizer": {"max_evaluations": 300, "max_iterations": 60, "wall_seconds_per_model": 600, "starts": 2, "min_fit_cases": 100, "rank_rcond": 1e-10, "max_condition": 100000000.0},
  "workers": 1,
